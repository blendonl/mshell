# Build objects
*.o
*.obj
*.lto

# Version stamp — makes a VERSION bump invalidate the objects that bake it in
.version-*

# Build output / release artifacts
/mshell.exe
/dist/

# Vendored Lua build artifacts (source is tracked, objects are not)
/vendor/lua/src/*.o
/vendor/lua/src/lua
/vendor/lua/src/luac
/vendor/lua/src/liblua.a

# Runtime logs
mshell.log

# Editor / OS cruft
*~
*.swp
.DS_Store
Thumbs.db

# Host-built test binaries (sources stay tracked)
/test/test_*
!/test/test_*.c
/test/lua
/tools/gen_lua_meta
/tools/*.exe
/mshelld.exe

# Detached debug symbols
*.debug

# Claude Code session state and worktrees — never part of the project.
.claude/
