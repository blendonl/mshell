Windows Registry Editor Version 5.00

; ============================================================================
;  Reverts harden.reg — re-enables the Windows hotkeys, Win+L / lock, Game Bar,
;  the default accessibility hotkeys, and the default hook timeout.
;  A "=-" line deletes the value (restoring the OS default). Takes effect on
;  next sign-in.
; ============================================================================

; --- Re-enable Win+key hotkeys (delete the policy) --------------------------
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer]
"NoWinKeys"=-
"DisabledHotkeys"=-

; --- Restore the default low-level hook timeout (delete the override) --------
[HKEY_CURRENT_USER\Control Panel\Desktop]
"LowLevelHooksTimeout"=-

; --- Re-enable Win+L / lock workstation -------------------------------------
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Policies\System]
"DisableLockWorkstation"=dword:00000000

; --- Re-enable Game Bar (Win+G) + Game DVR ----------------------------------
[HKEY_CURRENT_USER\System\GameConfigStore]
"GameDVR_Enabled"=dword:00000001
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\GameDVR]
"AppCaptureEnabled"=dword:00000001

; --- Restore Sticky Keys default --------------------------------------------
[HKEY_CURRENT_USER\Control Panel\Accessibility\StickyKeys]
"Flags"="510"

; --- Restore Filter Keys default --------------------------------------------
[HKEY_CURRENT_USER\Control Panel\Accessibility\Keyboard Response]
"Flags"="126"

; --- Restore Toggle Keys default --------------------------------------------
[HKEY_CURRENT_USER\Control Panel\Accessibility\ToggleKeys]
"Flags"="62"

; --- Restore High Contrast default ------------------------------------------
[HKEY_CURRENT_USER\Control Panel\Accessibility\HighContrast]
"Flags"="126"

; --- Restore Mouse Keys default ---------------------------------------------
[HKEY_CURRENT_USER\Control Panel\Accessibility\MouseKeys]
"Flags"="62"

; --- Restore bare PrtScn -> Snipping Tool -----------------------------------
[HKEY_CURRENT_USER\Control Panel\Keyboard]
"PrintScreenKeyForSnippingEnabled"=dword:00000001
