Windows Registry Editor Version 5.00

; ============================================================================
;  mshell harden.reg — disable Windows' built-in keyboard shortcuts.
;
;  LAYERING (important):
;    * The PRIMARY mechanism is mshell's low-level keyboard hook. It eats the
;      Win key before Windows sees it, so every Win+* combo is already mshell's
;      and no OS shortcut fires — no registry key required.
;    * These entries are the second layer: the chords the hook CANNOT reach
;      (accessibility hotkeys, bare PrtScn, lock), a fallback for the moments
;      the hook is not active (startup, the UAC secure desktop) and for
;      `--test` mode where Explorer is running, and a longer hook timeout so a
;      momentary stall can't get the hook dropped (which is what leaves the
;      Win key "stuck").
;
;  Ctrl+Alt+Del is a kernel Secure Attention Sequence and cannot be disabled by
;  anything here or anywhere in user space. That is by design.
;
;  Apply:   double-click, or  reg import harden.reg   (install.bat does this)
;  Undo:    run harden-undo.reg
;  Most of these take effect on next sign-in.
; ============================================================================

; --- Turn off ALL Win+key hotkeys -------------------------------------------
; Blanket "disable Windows Key hotkeys" policy. It is enforced by the shell, so
; it is only actually active in --test mode (Explorer running); as the mshell
; shell the hook is what disables Win+*. It is set here so both modes behave the
; same and nothing leaks during the brief pre-hook startup window.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer]
"NoWinKeys"=dword:00000001
; To disable only SPECIFIC letters instead of all of them, remove NoWinKeys and
; use DisabledHotkeys — each character is one disabled Win+<char>, e.g.:
;   "DisabledHotkeys"="ACDEFGHIKLMOPRSTUVWX"

; --- Keep the low-level keyboard hook from being dropped ---------------------
; If a low-level hook callback ever exceeds this many milliseconds, Windows runs
; the event WITHOUT the hook — which leaks a swallowed Win-down and leaves Win
; "stuck" (bare `k` then behaves like Win+K). mshell's hook does no I/O and is
; fast, but a generous timeout (1000 ms = 0x3e8) removes the failure mode.
; NEVER add logging or other blocking calls inside the hook itself.
[HKEY_CURRENT_USER\Control Panel\Desktop]
"LowLevelHooksTimeout"=dword:000003e8

; --- Win+L / lock workstation -----------------------------------------------
; Winlogon-level, below the hook. Eating the Win key usually stops Win+L too,
; but this guarantees it and also removes "Lock" from the Ctrl+Alt+Del screen.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Policies\System]
"DisableLockWorkstation"=dword:00000001

; --- Game Bar (Win+G) + Game DVR --------------------------------------------
; Independent of the shell: turns the capture overlay off entirely, so Win+G
; (if it ever leaks past the hook) does nothing.
[HKEY_CURRENT_USER\System\GameConfigStore]
"GameDVR_Enabled"=dword:00000000
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\GameDVR]
"AppCaptureEnabled"=dword:00000000

; --- Sticky Keys  (tap Shift 5x) --------------------------------------------
; Flags 506 = feature available but hotkey activation OFF (default is 510).
[HKEY_CURRENT_USER\Control Panel\Accessibility\StickyKeys]
"Flags"="506"

; --- Filter Keys  (hold right Shift 8s) -------------------------------------
; Flags 122 = hotkey OFF (default is 126).
[HKEY_CURRENT_USER\Control Panel\Accessibility\Keyboard Response]
"Flags"="122"

; --- Toggle Keys  (hold NumLock 5s) -----------------------------------------
; Flags 38 = hotkey OFF (default is 62).
[HKEY_CURRENT_USER\Control Panel\Accessibility\ToggleKeys]
"Flags"="38"

; --- High Contrast  (Left Alt + Left Shift + PrtScn) ------------------------
; Clears HCF_HOTKEYACTIVE (0x04) from the default 126 -> 122, so the chord can
; no longer flip the whole screen into the high-contrast theme.
[HKEY_CURRENT_USER\Control Panel\Accessibility\HighContrast]
"Flags"="122"

; --- Mouse Keys  (Left Alt + Left Shift + NumLock) --------------------------
; Clears MKF_HOTKEYACTIVE (0x04) from the default 62 -> 58, so the numpad
; can't be hijacked into driving the mouse pointer.
[HKEY_CURRENT_USER\Control Panel\Accessibility\MouseKeys]
"Flags"="58"

; --- Bare PrtScn no longer opens the Snipping Tool overlay ------------------
; Win11 remaps an unmodified PrtScn to the snip overlay. The low-level hook
; only sees Win-modified keys, so turn the remap off here.
[HKEY_CURRENT_USER\Control Panel\Keyboard]
"PrintScreenKeyForSnippingEnabled"=dword:00000000
