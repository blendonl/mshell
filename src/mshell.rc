#include <winver.h>

#define VER_STR2(x) #x
#define VER_STR(x)  VER_STR2(x)
#define MSHELL_VERSION_STR \
    VER_STR(VER_MAJOR) "." VER_STR(VER_MINOR) "." VER_STR(VER_PATCH)

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif
#ifndef CREATEPROCESS_MANIFEST_RESOURCE_ID
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#endif

/* The manifest file is chosen at build time: the default asInvoker one, or the
   uiAccess="true" variant when the Makefile passes MSHELL_MANIFEST (make
   UIACCESS=1). windres expands the macro to the quoted file name. */
#ifndef MSHELL_MANIFEST
#define MSHELL_MANIFEST "mshell.exe.manifest"
#endif

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST MSHELL_MANIFEST

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    VER_MAJOR,VER_MINOR,VER_PATCH,0
    PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0x0L
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "mshell"
            VALUE "FileDescription",  "mshell - keyboard-driven tiling window manager and Windows shell replacement"
            VALUE "FileVersion",      MSHELL_VERSION_STR
            VALUE "InternalName",     "mshell"
            VALUE "LegalCopyright",   "MIT licensed"
            VALUE "OriginalFilename", "mshell.exe"
            VALUE "ProductName",      "mshell"
            VALUE "ProductVersion",   MSHELL_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
